# Public-site security headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# CSS and JavaScript use stable filenames, so require revalidation after deploys.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Local font files are version-stable and can be cached long-term.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images may be updated without filename hashing; cache briefly and revalidate.
/assets/images/*
  Cache-Control: public, max-age=86400, must-revalidate
